# =============================================================================
# Signal Bot — Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=signalbot
POSTGRES_PASSWORD=signalbot
POSTGRES_DB=signalbot
DATABASE_URL=postgresql+asyncpg://signalbot:signalbot@db:5432/signalbot

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Market Data — US
# Free key at https://polygon.io (Starter = 15-min delay, Stocks Starter for real-time)
# -----------------------------------------------------------------------------
POLYGON_API_KEY=your_polygon_api_key_here

# Free key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Free 250 req/day at https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=your_fmp_api_key_here

# -----------------------------------------------------------------------------
# Claude / Anthropic (LLM analysis layer)
# https://console.anthropic.com/settings/keys
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# -----------------------------------------------------------------------------
# Telegram notifications
# Create a bot via @BotFather, then find your chat_id via @userinfobot
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# -----------------------------------------------------------------------------
# Market Data — Japan
# J-Quants paid tier required for real-time JP data: https://jpx-jquants.com
# -----------------------------------------------------------------------------
JQUANTS_API_KEY=your_jquants_api_key_here

# kabu.com API for JP order routing: https://kabu.com/company/lp/api.html
KABU_API_KEY=your_kabu_api_key_here
KABU_API_SECRET=your_kabu_api_secret_here

# -----------------------------------------------------------------------------
# App settings
# -----------------------------------------------------------------------------
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

ENVIRONMENT=development
LOG_LEVEL=INFO
