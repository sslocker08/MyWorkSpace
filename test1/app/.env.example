# Admin credentials
ADMIN_USERNAME=admin
# SHA-256 hash of password. Generate with: node -e "require('crypto').createHash('sha256').update('YOUR_PASSWORD').digest('hex')"
# Default for dev: kanmi-admin-2024 → change before any deployment
ADMIN_PASSWORD_HASH=f1f1d31b0b0c64d5917b64f2f23d783c9ce110db9992c9b18de36b775eb7e6ff
# 32+ char random secret for JWT signing. Generate with: openssl rand -hex 32
ADMIN_JWT_SECRET=change-this-to-a-random-32-char-secret-before-deploy
