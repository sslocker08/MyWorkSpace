<?xml version="1.0" encoding="UTF-8"?>
<!--
  KIBI 三社フロー パイプライン定期実行 launchd 雛形（example）
  設計正本: Contracts/automation-design-draft.md §5（ローカル launchd の定期 headless 実行）。

  これは「雛形」。実値（特に SLACK_WEBHOOK_URL）は空のまま。設置/有効化は Sota 承認後。
  手順は同ディレクトリ README.md を参照（コピー先・実値注入・launchctl load・Tunnel/ACL）。

  ■ このまま load しない（理由）:
    1) Label/出力パスはユーザー環境に合わせて確認すること（パスは /絶対パス/to/MyWorkSpace/KIBI のプレースホルダ＝各自の環境の絶対パスへ置換）。
    2) SLACK_WEBHOOK_URL が空のままだと pipeline-notify.js は fail-safe で stdout へ digest を出すだけ（Slack へは飛ばない）。
       実際にスマホ push したい場合のみ、コピーした実体（.example でない方）に実値を入れる。
       実値の入った plist は Git 追跡外に置くこと（Secret 流出防止・Contracts/security-policy.md）。

  ■ 設置先の例（実体）:
    ~/Library/LaunchAgents/jp.kibi.pipeline.plist
    （ProgramArguments は本ラッパ run-pipeline.sh を絶対パスで指す。下記参照）

  ■ 終了コードの扱い:
    run-pipeline.sh は scan→notify を順に呼び、要人間承認/送信失敗を exit 2 等で伝播する。
    launchd は終了コードでジョブを止めはしないが、StandardErrorPath のログで失敗を確認できる。
-->
<plist version="1.0">
<dict>
  <!-- 一意ラベル（逆DNS推奨）。launchctl の load/unload/list はこのラベルで指定する。 -->
  <key>Label</key>
  <string>jp.kibi.pipeline</string>

  <!-- 実行プログラム: bash で薄ラッパを起動（scan→notify を順に実行）。
       launchd は絶対パスが必須。下記プレースホルダ /絶対パス/to/MyWorkSpace/KIBI を各自の環境の絶対パスへ置換。 -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/絶対パス/to/MyWorkSpace/KIBI/Internal/Secretary/tools/ops/run-pipeline.sh</string>
  </array>

  <!-- 走査基点。orders-scan.js は __dirname 基準で解決するため必須ではないが、相対挙動の安定のため明示。 -->
  <key>WorkingDirectory</key>
  <string>/絶対パス/to/MyWorkSpace/KIBI</string>

  <!-- 定期実行間隔（秒）。既定 600 秒＝10分（設計 §5.1）。短くしすぎない（GPT Plus 負荷・「急がない」哲学）。 -->
  <key>StartInterval</key>
  <integer>600</integer>

  <!-- load 直後の即時起動はしない（false）。最初の起動まで StartInterval を待つ。
       手動で1回流したいときは launchctl kickstart で叩く（README 参照）。 -->
  <key>RunAtLoad</key>
  <false/>

  <!-- 環境変数の注入。SLACK_WEBHOOK_URL は雛形では「空」。実体側にのみ実値を入れる（Secret はここに直書きしない方針）。
       PATH に node の場所を含めること（GUI launchd は最小 PATH のため node を見つけられないことがある）。
       node が nvm 配下等にある場合は run-pipeline.sh 側に NODE_BIN=絶対パス を足すか、ここで PATH を補う。 -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>SLACK_WEBHOOK_URL</key>
    <string></string>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <!-- 任意: notify を Slack へ飛ばさず試走したいとき DRY=1 を一時的に入れる（常用しない）。
    <key>DRY</key>
    <string>1</string>
    -->
  </dict>

  <!-- 標準出力/エラーのログ。ローテーションは launchd では行わないので、肥大時は別途 newsyslog/logrotate を検討。
       ログには ID・状態・件数のみ出る設計（Secret/個人情報は出ない＝両 JS の鉄則）。 -->
  <key>StandardOutPath</key>
  <string>/絶対パス/to/MyWorkSpace/KIBI/Internal/Secretary/tools/ops/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/絶対パス/to/MyWorkSpace/KIBI/Internal/Secretary/tools/ops/logs/launchd.err.log</string>

  <!-- プロセスの実行優先度を下げる（バックグラウンド低負荷）。任意。 -->
  <key>Nice</key>
  <integer>5</integer>

  <!-- 異常終了時に launchd が即座に再起動し続けるのを防ぐ（スロットリング下限・既定10秒で十分）。
       無人ループで暴走しないための安全側。 -->
  <key>ThrottleInterval</key>
  <integer>60</integer>
</dict>
</plist>
