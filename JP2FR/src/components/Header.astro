---
// critique: P5 H4 E4 S4 R4 V4
import { useT } from '../lib/i18n';
import type { Locale } from '../lib/i18n';
import { localePath } from '../lib/routes';
import LocaleSwitcher from './LocaleSwitcher.astro';
import Hamburger from './Hamburger.astro';

export interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const t = useT(locale);

const navLinks = [
  { key: 'nav.founders', href: localePath(locale, '/founders/') },
  { key: 'nav.products', href: localePath(locale, '/products/') },
];
const cartHref = localePath(locale, '/cart/');
const homeHref = localePath(locale, '/');
---

<header class="site-header">
  <div class="site-header-inner">
    <a href={homeHref} class="logo" aria-label={t('nav.home')}>
      <span class="logo-seal" aria-hidden="true">版</span>
      <span class="logo-word">JP2FR</span>
    </a>

    <nav class="site-nav" aria-label={t('nav.menu')}>
      <ul>
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href} class="nav-link">
                {t(link.key)}
              </a>
            </li>
          ))
        }
        <li>
          <a href={cartHref} class="nav-link nav-cart">
            {t('nav.cart')}
            <span class="cart-badge" data-cart-badge>0</span>
          </a>
        </li>
      </ul>
    </nav>

    <div class="site-header-right">
      <div class="header-locale">
        <LocaleSwitcher locale={locale} path={path} />
      </div>

      <button
        type="button"
        class="menu-toggle"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t('a11y.open_menu')}
        data-label-open={t('a11y.open_menu')}
        data-label-close={t('a11y.close_menu')}
      >
        <span class="menu-toggle-bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<Hamburger locale={locale} path={path} />

<script>
  const header = document.querySelector<HTMLElement>('.site-header');

  if (header) {
    const onScroll = (): void => {
      if (window.scrollY > 24) {
        header.classList.add('is-scrolled');
      } else {
        header.classList.remove('is-scrolled');
      }
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
  }

  /* Transparent-over-hero → solid kinari on scroll. The color/shadow swap is
     carried by a pseudo-element whose *opacity* transitions (motion §4 bans
     animating background-color/box-shadow directly). */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--color-kinari);
    box-shadow: var(--shadow-paper);
    opacity: 0;
    transition: opacity var(--duration-ui) var(--ease-mie);
  }

  .site-header.is-scrolled::before {
    opacity: 1;
  }

  .site-header-inner {
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--space-4) var(--space-5);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--color-sumi);
  }

  .logo-seal {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: var(--radius);
    background: var(--color-shu);
    color: var(--color-kinari);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    line-height: 1;
  }

  .logo-word {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    letter-spacing: 0.02em;
  }

  .site-nav {
    display: none;
  }

  .site-nav ul {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    list-style: none;
  }

  /* Color swaps are instant (state, not animation) — §4 whitelists only
     transform/opacity as animated properties. The underline reveal below is
     the actual animated motion cue (transform: scaleX, not `right`). */
  .nav-link {
    position: relative;
    color: var(--color-sumi);
    text-decoration: none;
    font-size: var(--text-base);
    padding-block: var(--space-1);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background: var(--color-shu);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-ui) var(--ease-mie);
  }

  .nav-link:hover {
    color: var(--color-ai);
  }

  .nav-link:hover::after,
  .nav-link:focus-visible::after {
    transform: scaleX(1);
  }

  .nav-link:focus-visible {
    outline: 2px solid var(--color-shu);
    outline-offset: 4px;
  }

  .nav-link:active {
    color: var(--color-sumi);
  }

  .nav-cart {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .cart-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.25rem;
    height: 1.25rem;
    padding-inline: var(--space-1);
    border-radius: var(--radius);
    background: var(--color-ai);
    color: var(--color-kinari);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
  }

  .site-header-right {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  /* Locale switcher lives twice on mobile otherwise (here + inside the
     Hamburger overlay); keep the header copy desktop-only. */
  .header-locale {
    display: none;
  }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: var(--border-hairline);
    border-radius: var(--radius);
    background: transparent;
    cursor: pointer;
    transition: transform var(--duration-ui-fast) var(--ease-mie);
  }

  .menu-toggle-bars,
  .menu-toggle-bars::before,
  .menu-toggle-bars::after {
    content: '';
    display: block;
    width: 1.1rem;
    height: 2px;
    background: var(--color-sumi);
  }

  .menu-toggle-bars {
    position: relative;
  }

  .menu-toggle-bars::before,
  .menu-toggle-bars::after {
    position: absolute;
    transition: transform var(--duration-ui-fast) var(--ease-mie);
  }

  .menu-toggle-bars::before {
    top: -6px;
  }

  .menu-toggle-bars::after {
    top: 6px;
  }

  .menu-toggle:hover {
    border-color: var(--color-ai);
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-toggle,
    .menu-toggle-bars::before,
    .menu-toggle-bars::after,
    .nav-link::after {
      transition: none;
    }
  }

  .menu-toggle:focus-visible {
    outline: 2px solid var(--color-shu);
    outline-offset: 2px;
  }

  .menu-toggle:active {
    transform: scale(0.94);
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle-bars {
    background: transparent;
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle-bars::before {
    transform: translateY(6px) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle-bars::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  @media (min-width: 768px) {
    .site-nav {
      display: block;
    }

    .header-locale {
      display: block;
    }

    .menu-toggle {
      display: none;
    }
  }
</style>
