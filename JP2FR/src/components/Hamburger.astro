---
// critique: P4 H4 E4 S4 R4 V4
import { useT } from '../lib/i18n';
import type { Locale } from '../lib/i18n';
import { localePath } from '../lib/routes';
import LocaleSwitcher from './LocaleSwitcher.astro';

export interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const t = useT(locale);

const links = [
  { key: 'nav.home', href: localePath(locale, '/') },
  { key: 'nav.founders', href: localePath(locale, '/founders/') },
  { key: 'nav.products', href: localePath(locale, '/products/') },
  { key: 'nav.cart', href: localePath(locale, '/cart/') },
];
---

<div id="mobile-menu" class="hamburger-overlay" role="dialog" aria-modal="true" aria-label={t('nav.menu')}>
  <div class="hamburger-inner">
    <button type="button" class="hamburger-close" data-menu-close aria-label={t('a11y.close_menu')}>
      <span class="hamburger-close-mark" aria-hidden="true">×</span>
      <span>{t('nav.close')}</span>
    </button>

    <nav class="hamburger-nav" aria-label={t('nav.menu')}>
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{t(link.key)}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hamburger-footer">
      <LocaleSwitcher locale={locale} path={path} />

      {/* Site-wide SNS profiles are not yet defined (only per-founder sns
         exists in content) — rendered inert per DESIGN.md §6 honesty gate
         rather than faked as working links. */}
      <div class="hamburger-sns" aria-hidden="true">
        <span class="sns-icon">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none" />
          </svg>
        </span>
        <span class="sns-icon">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M4 4l16 16M20 4L4 20" />
          </svg>
        </span>
      </div>
    </div>
  </div>
</div>

<script>
  const overlay = document.getElementById('mobile-menu');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');

  if (overlay && toggle) {
    const closeButtons = overlay.querySelectorAll<HTMLElement>('[data-menu-close]');
    const focusableSelector = 'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])';
    let lastFocused: HTMLElement | null = null;

    const setToggleLabel = (label: string | undefined): void => {
      if (label) toggle.setAttribute('aria-label', label);
    };

    const onKeydown = (event: KeyboardEvent): void => {
      if (event.key === 'Escape') {
        event.preventDefault();
        closeMenu();
        return;
      }
      if (event.key !== 'Tab') return;

      const focusables = Array.from(overlay.querySelectorAll<HTMLElement>(focusableSelector)).filter(
        (el) => el.offsetParent !== null,
      );
      if (focusables.length === 0) return;

      const first = focusables[0];
      const last = focusables[focusables.length - 1];

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    };

    function openMenu(): void {
      lastFocused = document.activeElement as HTMLElement | null;
      overlay!.classList.add('is-open');
      toggle!.setAttribute('aria-expanded', 'true');
      setToggleLabel(toggle!.dataset.labelClose);
      document.body.style.overflow = 'hidden';
      overlay!.querySelector<HTMLElement>(focusableSelector)?.focus();
      document.addEventListener('keydown', onKeydown);
    }

    function closeMenu(): void {
      overlay!.classList.remove('is-open');
      toggle!.setAttribute('aria-expanded', 'false');
      setToggleLabel(toggle!.dataset.labelOpen);
      document.body.style.overflow = '';
      document.removeEventListener('keydown', onKeydown);
      (lastFocused ?? toggle)!.focus();
    }

    toggle.addEventListener('click', () => {
      if (overlay.classList.contains('is-open')) closeMenu();
      else openMenu();
    });

    closeButtons.forEach((btn) => btn.addEventListener('click', closeMenu));
  }
</script>

<style>
  .hamburger-overlay {
    position: fixed;
    inset: 0;
    z-index: var(--z-overlay);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-sumi);
    color: var(--color-kinari);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-16px);
    pointer-events: none;
    transition:
      opacity var(--duration-ui-slow) var(--ease-mie),
      transform var(--duration-ui-slow) var(--ease-mie),
      visibility 0s linear var(--duration-ui-slow);
  }

  .hamburger-overlay.is-open {
    opacity: 1;
    visibility: visible;
    transform: none;
    pointer-events: auto;
    transition:
      opacity var(--duration-ui-slow) var(--ease-mie),
      transform var(--duration-ui-slow) var(--ease-mie),
      visibility 0s linear 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .hamburger-overlay,
    .hamburger-close,
    .hamburger-nav a {
      transition: none;
    }
  }

  .hamburger-inner {
    width: 100%;
    max-width: 28rem;
    padding: var(--space-9) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-9);
  }

  .hamburger-close {
    align-self: flex-end;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: transparent;
    border: none;
    color: var(--color-kinari);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    cursor: pointer;
    padding: var(--space-2);
    transition: transform var(--duration-ui-fast) var(--ease-mie);
  }

  .hamburger-close-mark {
    font-size: var(--text-xl);
    line-height: 1;
  }

  .hamburger-close:hover {
    color: var(--color-asagi);
  }

  .hamburger-close:focus-visible {
    outline: 2px solid var(--color-shu);
    outline-offset: 2px;
  }

  .hamburger-close:active {
    transform: scale(0.96);
  }

  .hamburger-nav ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  /* Color swap is instant (state, not animation — §4); the felt motion cue
     on hover/focus is the transform shift only. */
  .hamburger-nav a {
    display: inline-block;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    color: var(--color-kinari);
    text-decoration: none;
    transform: translateX(0);
    transition: transform var(--duration-ui) var(--ease-mie);
  }

  .hamburger-nav a:hover,
  .hamburger-nav a:focus-visible {
    color: var(--color-asagi);
    transform: translateX(var(--space-3));
  }

  .hamburger-nav a:focus-visible {
    outline: 2px solid var(--color-shu);
    outline-offset: 4px;
  }

  .hamburger-nav a:active {
    color: var(--color-shu);
  }

  .hamburger-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    border-top: 1px solid color-mix(in oklch, var(--color-kinari) 20%, transparent);
    padding-top: var(--space-6);
  }

  .hamburger-footer :global(.locale-link) {
    color: var(--color-kinari);
  }

  .hamburger-footer :global(.locale-link.is-current) {
    color: var(--color-kinari);
  }

  .hamburger-sns {
    display: flex;
    gap: var(--space-4);
    color: var(--color-kinari);
  }
</style>
