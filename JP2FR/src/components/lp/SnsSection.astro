---
// critique: P4 H3 E4 S4 R4 V3
//
// SNS closer. No site-wide social accounts are defined in content today
// (only per-founder sns.instagram/x exist) — kept visually present but
// inert, same honesty-gate reasoning Footer.astro already applies to its
// own footer-sns block (DESIGN.md §6: don't dress up placeholders as
// working links).
import { useT } from '../../lib/i18n';
import type { Locale } from '../../lib/i18n';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useT(locale);
---

<section data-sns class="sns">
  <div class="sns-inner">
    <h2>{t('lp.sns.title')}</h2>

    <div class="sns-follow" aria-hidden="true">
      <span class="sns-follow-label">{t('lp.sns.follow')}</span>
      <span class="sns-icon">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none" />
        </svg>
      </span>
      <span class="sns-icon">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M4 4l16 16M20 4L4 20" />
        </svg>
      </span>
    </div>
  </div>
</section>

<style>
  .sns {
    padding-block: var(--space-12);
    text-align: center;
  }

  .sns-inner {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--space-5);
  }

  .sns-follow {
    margin-top: var(--space-6);
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
    color: var(--color-sumi-usu);
  }

  .sns-follow-label {
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
  }

  .sns-icon {
    display: inline-flex;
  }
</style>
