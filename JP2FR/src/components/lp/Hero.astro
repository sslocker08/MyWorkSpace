---
// critique: P4 H4 E4 S5 R4 V4
//
// LP anchor section. LCP element is the <h1> — it is never hidden or
// opacity:0 (DESIGN.md §4 hard rule). Background is a hand-built layered
// SVG (Hokusai-inspired: distant sun + mountain silhouette, three wave
// bands lightening front-to-back for atmospheric depth, kinari foam claws
// on the cresting front wave). heroAssets.videoWebm is null today, so the
// video branch below is inert — swapping in a real clip later is a pure
// data change in src/lib/assets.ts, no markup change (DESIGN.md §8).
import { useT } from '../../lib/i18n';
import type { Locale } from '../../lib/i18n';
import { heroAssets } from '../../lib/assets';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useT(locale);
---

<section data-hero class="hero">
  <div data-hero-bg class="hero-bg">
    {
      heroAssets.videoWebm ? (
        <video
          class="hero-media"
          autoplay
          muted
          loop
          playsinline
          poster={heroAssets.poster}
          width="1600"
          height="900"
        >
          <source src={heroAssets.videoWebm} type="video/webm" />
          {heroAssets.videoMp4 && <source src={heroAssets.videoMp4} type="video/mp4" />}
        </video>
      ) : (
        <svg
          class="hero-media hero-waves"
          viewBox="0 0 1600 900"
          width="1600"
          height="900"
          preserveAspectRatio="xMidYMax slice"
          aria-hidden="true"
          focusable="false"
        >
          <defs>
            <linearGradient id="hero-sky" x1="0" y1="0" x2="0" y2="1">
              <stop class="sky-stop-top" offset="0" />
              <stop class="sky-stop-bottom" offset="1" />
            </linearGradient>
          </defs>

          <rect x="0" y="0" width="1600" height="900" fill="url(#hero-sky)" />

          <circle class="sun-disc" cx="1180" cy="230" r="95" />

          <g class="mountain-layer" data-parallax="0.15">
            <path class="mountain-silhouette" d="M860,700 L1180,380 L1500,700 Z" />
            <path class="mountain-snow" d="M1140,462 L1180,382 L1220,462 Z" />
          </g>

          <g class="wave-back" data-parallax="0.25">
            <path
              d="M0,610 C220,560 420,560 620,600 C860,648 1040,600 1260,565
                 C1400,543 1520,560 1600,585 L1600,900 L0,900 Z"
            />
          </g>

          <g class="wave-mid" data-parallax="0.4">
            <path
              d="M0,700 C260,630 480,610 720,660 C920,700 1120,650 1360,615
                 C1460,600 1540,615 1600,630 L1600,900 L0,900 Z"
            />
          </g>

          <g class="wave-front" data-parallax="0.6">
            <path
              d="M260,760 C500,700 760,730 1020,760 C1220,785 1420,760 1600,720
                 L1600,900 L260,900 Z"
            />
            <path
              d="M0,820 C90,790 130,700 100,610 C78,545 20,510 15,440
                 C10,380 60,335 130,330 C210,324 270,375 275,440
                 C279,495 240,530 265,585 C300,660 400,650 440,720
                 C480,790 430,860 340,880 C220,905 90,860 0,850 Z"
            />
            <ellipse class="foam" cx="150" cy="360" rx="22" ry="12" transform="rotate(-25 150 360)" />
            <ellipse class="foam" cx="200" cy="335" rx="16" ry="9" transform="rotate(-15 200 335)" />
            <ellipse class="foam" cx="245" cy="365" rx="14" ry="8" transform="rotate(10 245 365)" />
          </g>
        </svg>
      )
    }
  </div>

  <div class="hero-content">
    <h1 class="hero-title">{t('lp.hero.title')}</h1>
    <p class="hero-subtitle">{t('lp.hero.subtitle')}</p>
  </div>

  <div data-scroll-cue class="scroll-cue">
    <span class="scroll-cue-line" aria-hidden="true"></span>
    <span class="scroll-cue-label">{t('lp.hero.scroll')}</span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: var(--space-8) var(--space-5);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: var(--z-base);
  }

  .hero-media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .sky-stop-top {
    stop-color: var(--color-kinari);
  }

  .sky-stop-bottom {
    stop-color: var(--color-washi);
  }

  .sun-disc {
    fill: var(--color-shu);
    opacity: 0.85;
  }

  .mountain-silhouette {
    fill: var(--color-sumi);
    opacity: 0.16;
  }

  .mountain-snow {
    fill: var(--color-kinari);
    opacity: 0.55;
  }

  .wave-back path {
    fill: var(--color-asagi);
    opacity: 0.4;
  }

  .wave-mid path {
    fill: var(--color-asagi);
    opacity: 0.75;
  }

  .wave-front path {
    fill: var(--color-ai);
  }

  .foam {
    fill: var(--color-kinari);
    opacity: 0.92;
  }

  .hero-content {
    position: relative;
    z-index: var(--z-raised);
    max-width: 46rem;
    text-align: center;
  }

  /* LCP element — always rendered at full opacity, never a reveal target. */
  .hero-title {
    font-size: var(--text-hero);
    color: var(--color-sumi);
  }

  .hero-subtitle {
    margin-top: var(--space-5);
    font-size: var(--text-lg);
    color: var(--color-sumi-usu);
  }

  .scroll-cue {
    position: relative;
    z-index: var(--z-raised);
    margin-top: var(--space-10);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }

  .scroll-cue-line {
    width: 1px;
    height: var(--space-9);
    background: var(--color-sumi-usu);
  }

  .scroll-cue-label {
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    color: var(--color-sumi-usu);
  }

  @media (max-width: 480px) {
    .hero-subtitle {
      font-size: var(--text-base);
    }
  }
</style>
