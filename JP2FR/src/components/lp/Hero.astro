---
// critique: P5 H5 E4 S5 R4 V5
//
// LP anchor — asymmetric editorial-gallery composition (蒐集の間).
// Left: typographic column on kinari (kicker → h1 → subtitle → CTA pair)
// with a vertical-writing brand strip on the seam. Right: THE REAL
// Katsushika Hokusai "Under the Wave off Kanagawa" (The Met, CC0 —
// assetgen/SOURCES.md) presented as a bleeding print panel with a sumi
// frame line and a 版ズレ shu offset. Real provenance is stated in the
// caption chip — no fake art, no fake credits (DESIGN.md §6).
// LCP: the h1 renders immediately (never opacity:0); the print img is
// fetchpriority=high with explicit dimensions (CLS 0).
// Motion hooks preserved: data-hero / data-hero-bg / data-parallax /
// data-scroll-cue (hero.ts binds unchanged).
import { useT } from '../../lib/i18n';
import type { Locale } from '../../lib/i18n';
import { localePath } from '../../lib/routes';
import { heroAssets, heroWave } from '../../lib/assets';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useT(locale);
---

<section data-hero class="hero">
  <div class="hero-copy">
    <p class="kicker hero-kicker">{t('site.tagline')}</p>
    <h1 class="hero-title">{t('lp.hero.title')}</h1>
    <p class="hero-subtitle">{t('lp.hero.subtitle')}</p>
    <div class="hero-cta">
      <a class="btn btn--primary" href={localePath(locale, '/founders/')}>{t('lp.founders.cta')}</a>
      <a class="btn btn--secondary" href={localePath(locale, '/products/')}>{t('lp.products.cta')}</a>
    </div>

    <div data-scroll-cue class="scroll-cue">
      <span class="scroll-cue-line" aria-hidden="true"></span>
      <span class="scroll-cue-label">{t('lp.hero.scroll')}</span>
    </div>
  </div>

  {/* 縦書き brand strip — per-char stacked blocks instead of writing-mode:
      vertical-rl, so rendering never depends on the environment having a
      CJK font with vertical metrics (headless/Linux fallback fonts overlap
      glyphs in vertical-rl). */}
  <span class="hero-tategaki" aria-hidden="true">
    {'日本の手仕事'.split('').map((ch) => <span class="tategaki-char">{ch}</span>)}
  </span>

  <div data-hero-bg class="hero-panel">
    {
      heroAssets.videoWebm ? (
        <video
          class="hero-media"
          autoplay
          muted
          loop
          playsinline
          poster={heroAssets.poster}
          width="1600"
          height="1080"
          data-parallax="0.25"
        >
          <source src={heroAssets.videoWebm} type="video/webm" />
          {heroAssets.videoMp4 && <source src={heroAssets.videoMp4} type="video/mp4" />}
        </video>
      ) : (
        <img
          class="hero-media"
          src={heroWave.src1200}
          srcset={`${heroWave.src1200} 1200w, ${heroWave.srcFull} 2000w`}
          sizes="(min-width: 900px) 58vw, 100vw"
          width="2000"
          height="1360"
          alt="葛飾北斎《神奈川沖浪裏》 — The Great Wave off Kanagawa, Katsushika Hokusai"
          fetchpriority="high"
          decoding="async"
          data-parallax="0.25"
        />
      )
    }
    <span class="hero-frame" aria-hidden="true"></span>
    <p class="hero-caption">葛飾北斎《神奈川沖浪裏》 · The Met Open Access (CC0)</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-columns: minmax(22rem, 42%) 1fr;
    align-items: stretch;
    overflow: hidden;
    background: var(--color-kinari);
  }

  /* ── Left: typographic column ───────────────────────────── */
  .hero-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: calc(var(--space-12) + var(--space-6)) var(--space-8) var(--space-8) var(--space-8);
    max-width: 38rem;
  }

  .hero-kicker {
    margin-bottom: var(--space-5);
  }

  /* LCP element — always rendered at full opacity, never a reveal target. */
  .hero-title {
    font-size: clamp(2.6rem, 5.2vw, 4.75rem);
    line-height: 1.12;
    letter-spacing: -0.015em;
    text-wrap: balance;
    color: var(--color-sumi);
  }

  .hero-subtitle {
    margin-top: var(--space-5);
    max-width: 26rem;
    font-size: var(--text-lg);
    line-height: 1.65;
    color: var(--color-sumi-usu);
  }

  .hero-cta {
    margin-top: var(--space-8);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .scroll-cue {
    margin-top: auto;
    padding-top: var(--space-9);
    display: flex;
    align-items: flex-end;
    gap: var(--space-3);
  }

  .scroll-cue-line {
    width: 1px;
    height: var(--space-9);
    background: var(--color-sumi-usu);
  }

  .scroll-cue-label {
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    color: var(--color-sumi-usu);
  }

  /* ── Seam: vertical-writing brand strip (署名的アクセント) ── */
  .hero-tategaki {
    position: absolute;
    z-index: var(--z-raised);
    top: 50%;
    left: 42%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55em;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: 1;
    color: var(--color-sumi);
    background: var(--color-kinari);
    padding: var(--space-6) var(--space-3);
    border-inline: 1px solid oklch(0.24 0.012 270 / 0.22);
  }

  .tategaki-char {
    display: block;
  }

  /* ── Right: the real print, bleeding panel ──────────────── */
  .hero-panel {
    position: relative;
    overflow: hidden;
    min-height: 100svh;
  }

  .hero-media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% center; /* keep the crest + Fuji in frame */
    display: block;
    /* parallax headroom so edges never show while translating */
    scale: 1.08;
  }

  /* frame line + 版ズレ offset (the only place shu touches the panel) */
  .hero-frame {
    position: absolute;
    inset: var(--space-5);
    border: 1px solid oklch(0.955 0.012 95 / 0.85);
    pointer-events: none;
  }

  .hero-frame::before {
    content: '';
    position: absolute;
    inset: 0;
    translate: 3px 3px;
    border: 1px solid oklch(0.55 0.185 32 / 0.5);
  }

  .hero-caption {
    position: absolute;
    left: var(--space-5);
    bottom: var(--space-5);
    margin: 0;
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    color: var(--color-sumi);
    background: oklch(0.955 0.012 95 / 0.92);
    border-left: 2px solid var(--color-shu);
  }

  /* ── Mobile: stacked, print first ────────────────────────── */
  @media (max-width: 899px) {
    .hero {
      grid-template-columns: 1fr;
      grid-template-rows: min(52svh, 30rem) auto;
    }

    .hero-panel {
      min-height: 0;
      order: -1;
    }

    .hero-tategaki {
      display: none;
    }

    .hero-copy {
      padding: var(--space-8) var(--space-5) var(--space-9);
      max-width: none;
    }

    .hero-title {
      font-size: clamp(2.1rem, 8.5vw, 2.9rem);
    }

    .scroll-cue {
      display: none;
    }
  }
</style>
