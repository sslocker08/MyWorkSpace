---
// critique: P4 H4 E4 S4 R5 V3
import { useT } from '../lib/i18n';
import type { Locale } from '../lib/i18n';

export interface Props {
  items: { label: string; href?: string }[];
  locale: Locale;
}

const { items, locale } = Astro.props;
const t = useT(locale);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, Astro.site).toString() } : {}),
  })),
};
---

<nav class="breadcrumbs" aria-label={t('a11y.breadcrumb')}>
  <ol>
    {
      items.map((item, index) => {
        const isLast = index === items.length - 1;
        return (
          <li>
            {item.href && !isLast ? (
              <a href={item.href}>{item.label}</a>
            ) : (
              <span aria-current={isLast ? 'page' : undefined}>{item.label}</span>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<style>
  .breadcrumbs {
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--space-4) var(--space-5);
  }

  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-sumi-usu);
  }

  .breadcrumbs li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* 和文スラッシュ separator — decorative, generated content is not exposed
     to the accessibility tree in any current browser/AT combination. */
  .breadcrumbs li:not(:last-child)::after {
    content: '／';
    color: var(--color-sumi-usu);
  }

  .breadcrumbs a {
    color: var(--color-ai);
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: var(--color-shu);
    text-decoration: underline;
  }

  .breadcrumbs a:focus-visible {
    outline: 2px solid var(--color-shu);
    outline-offset: 2px;
  }

  .breadcrumbs a:active {
    color: var(--color-sumi);
  }

  .breadcrumbs [aria-current='page'] {
    color: var(--color-sumi);
    font-weight: 600;
  }
</style>
