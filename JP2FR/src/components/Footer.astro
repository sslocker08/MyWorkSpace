---
// critique: P4 H4 E4 S3 R4 V4
import { useT } from '../lib/i18n';
import type { Locale } from '../lib/i18n';
import { localePath } from '../lib/routes';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useT(locale);

const navLinks = [
  { key: 'nav.home', href: localePath(locale, '/') },
  { key: 'nav.founders', href: localePath(locale, '/founders/') },
  { key: 'nav.products', href: localePath(locale, '/products/') },
];

// Legal-page slugs are not part of the routes.ts contract beyond the
// mentions-légales example given in the brief; centralized here so a future
// legal-routing contract can replace this map in one place.
const legalLinks = [
  { key: 'footer.mentions', href: localePath(locale, '/legal/mentions-legales/') },
  { key: 'footer.privacy', href: localePath(locale, '/legal/privacy/') },
  { key: 'footer.cgv', href: localePath(locale, '/legal/cgv/') },
  { key: 'footer.tokushoho', href: localePath(locale, '/legal/tokushoho/') },
  { key: 'footer.cookies', href: localePath(locale, '/legal/cookies/') },
];

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="seigaiha-divider" aria-hidden="true">
    <img src="/textures/seigaiha.svg" alt="" width="1440" height="48" loading="lazy" decoding="async" />
  </div>

  <div class="site-footer-inner">
    <div class="footer-col footer-brand">
      <p class="footer-word">JP2FR</p>
      <p class="footer-tagline">{t('site.tagline')}</p>
    </div>

    <div class="footer-col footer-links">
      <nav class="footer-nav" aria-label={t('nav.menu')}>
        <ul>
          {
            navLinks.map((link) => (
              <li>
                <a href={link.href}>{t(link.key)}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav class="footer-legal" aria-label={t('footer.legal')}>
        <p class="footer-legal-heading">{t('footer.legal')}</p>
        <ul>
          {
            legalLinks.map((link) => (
              <li>
                <a href={link.href}>{t(link.key)}</a>
              </li>
            ))
          }
          <li>
            <button type="button" class="cookie-settings-btn" data-cookie-settings>
              {t('cookie.settings')}
            </button>
          </li>
        </ul>
      </nav>
    </div>

    {/* Site-wide SNS profiles are not yet defined (only per-founder sns
       exists in content) — rendered inert per DESIGN.md §6 honesty gate
       rather than faked as working links. */}
    <div class="footer-col footer-sns" aria-hidden="true">
      <span class="sns-icon">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none" />
        </svg>
      </span>
      <span class="sns-icon">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M4 4l16 16M20 4L4 20" />
        </svg>
      </span>
    </div>
  </div>

  <div class="site-footer-bottom">
    <p>&copy; {year} JP2FR — {t('footer.rights')}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-sumi);
    color: var(--color-kinari);
  }

  .seigaiha-divider {
    width: 100%;
    line-height: 0;
    overflow: hidden;
    transform: translateY(1px);
  }

  .seigaiha-divider img {
    width: 100%;
    height: auto;
    display: block;
  }

  .site-footer-inner {
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--space-10) var(--space-5);
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 12rem), 1fr));
    gap: var(--space-8);
  }

  .footer-word {
    font-family: var(--font-display);
    font-size: var(--text-xl);
  }

  .footer-tagline {
    margin-top: var(--space-2);
    color: color-mix(in oklch, var(--color-kinari) 70%, transparent);
    font-size: var(--text-sm);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
  }

  .footer-legal-heading {
    font-size: var(--text-xs);
    color: color-mix(in oklch, var(--color-kinari) 60%, transparent);
    margin-bottom: var(--space-3);
    letter-spacing: 0.04em;
  }

  .footer-nav ul,
  .footer-legal ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  /* Color swap is instant (state, not animation — §4 whitelists only
     transform/opacity as animated properties). */
  .footer-nav a,
  .footer-legal a,
  .cookie-settings-btn {
    display: inline-block;
    color: var(--color-kinari);
    text-decoration: none;
    font-size: var(--text-sm);
    background: transparent;
    border: none;
    padding: 0;
    font-family: var(--font-body);
    cursor: pointer;
    text-align: left;
    transform: translateX(0);
    transition: transform var(--duration-ui-fast) var(--ease-mie);
  }

  .footer-nav a:hover,
  .footer-legal a:hover,
  .cookie-settings-btn:hover {
    color: var(--color-asagi);
    transform: translateX(var(--space-2));
  }

  .footer-nav a:focus-visible,
  .footer-legal a:focus-visible,
  .cookie-settings-btn:focus-visible {
    outline: 2px solid var(--color-shu);
    outline-offset: 2px;
  }

  .footer-nav a:active,
  .footer-legal a:active,
  .cookie-settings-btn:active {
    color: var(--color-shu);
  }

  .footer-sns {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    color: color-mix(in oklch, var(--color-kinari) 70%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-nav a,
    .footer-legal a,
    .cookie-settings-btn {
      transition: none;
    }
  }

  .site-footer-bottom {
    border-top: 1px solid color-mix(in oklch, var(--color-kinari) 15%, transparent);
    padding: var(--space-5);
    text-align: center;
    font-size: var(--text-xs);
    color: color-mix(in oklch, var(--color-kinari) 70%, transparent);
  }
</style>
