---
// critique: P4 H4 E4 S4 R4 V3
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import ProductCard from '../../../components/ProductCard.astro';
import { useT, locales, type Locale } from '../../../lib/i18n';
import { localePath } from '../../../lib/routes';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = useT(locale);

const [allProducts, allFounders] = await Promise.all([getCollection('products'), getCollection('founders')]);

const founderOrder = new Map(allFounders.map((entry) => [entry.data.slug, entry.data]));

const products = allProducts
  .filter((entry) => entry.data.published)
  .map((entry) => entry.data)
  .sort((a, b) => {
    const founderA = founderOrder.get(a.founder)?.order ?? 0;
    const founderB = founderOrder.get(b.founder)?.order ?? 0;
    if (founderA !== founderB) return founderA - founderB;
    return a.order - b.order;
  });

const breadcrumbs = [
  { label: t('nav.home'), href: localePath(locale, '/') },
  { label: t('products.breadcrumb') },
];
---

<Base locale={locale} title={t('products.title')} path="/products/" breadcrumbs={breadcrumbs}>
  <header class="page-header">
    <p class="kicker">{t('lp.products.kicker')}</p>
    <h1>{t('products.title')}</h1>
    <p class="lead">{t('lp.products.title')}</p>
  </header>

  <div class="product-grid">
    {
      products.map((product) => (
        <ProductCard
          product={product}
          founderName={founderOrder.get(product.founder)?.name[locale] ?? ''}
          locale={locale}
        />
      ))
    }
  </div>
</Base>

<style>
  .page-header {
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--space-8) var(--space-5) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .page-header h1 {
    font-size: var(--text-2xl);
  }

  .lead {
    max-width: 60ch;
    color: var(--color-sumi-usu);
  }

  .product-grid {
    max-width: var(--container-max);
    margin-inline: auto;
    padding: 0 var(--space-5) var(--space-11);
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-6);
  }
</style>
