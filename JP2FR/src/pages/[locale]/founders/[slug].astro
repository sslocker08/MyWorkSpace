---
// critique: P4 H4 E4 S4 R4 V4
// (band rebuild: duotone backdrop + craft chip + full-color portrait; no
// separate "story" page exists so the comp's dark CTA button was dropped
// rather than fabricated — see worker brief item 4)
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import ProductCard from '../../../components/ProductCard.astro';
import { useT, locales, type Locale } from '../../../lib/i18n';
import { localePath } from '../../../lib/routes';

export async function getStaticPaths() {
  const allFounders = await getCollection('founders');
  const published = allFounders.filter((entry) => entry.data.published);

  return locales.flatMap((locale) =>
    published.map((entry) => ({
      params: { locale, slug: entry.data.slug },
      props: { founder: entry.data },
    })),
  );
}

interface Props {
  founder: CollectionEntry<'founders'>['data'];
}

const { locale } = Astro.params as { locale: Locale };
const { founder } = Astro.props;
const t = useT(locale);

const allProducts = await getCollection('products');
const founderProducts = allProducts
  .filter((entry) => entry.data.published && entry.data.founder === founder.slug)
  .map((entry) => entry.data)
  .sort((a, b) => a.order - b.order);

const founderName = founder.name[locale];
const bioParagraphs = founder.bio[locale].split(/\n{2,}/).filter(Boolean);
const duoPortrait = founder.portrait.replace(/portrait\.webp$/, 'portrait-duo.webp');

const productsHeading = t('founders.products_by', { name: founderName });

const snsEntries: { key: string; href: string | undefined }[] = [
  { key: 'instagram', href: founder.sns.instagram },
  { key: 'x', href: founder.sns.x },
  { key: 'site', href: founder.sns.site },
];
const snsLinks = snsEntries.filter(
  (entry): entry is { key: string; href: string } => Boolean(entry.href),
);

const breadcrumbs = [
  { label: t('nav.home'), href: localePath(locale, '/') },
  { label: t('founders.breadcrumb'), href: localePath(locale, '/founders/') },
  { label: founderName },
];
---

<Base locale={locale} title={founderName} path={`/founders/${founder.slug}/`} breadcrumbs={breadcrumbs}>
  <section class="founder-band">
    <img
      class="founder-band__backdrop"
      src={duoPortrait}
      alt=""
      aria-hidden="true"
      width="960"
      height="960"
      loading="eager"
      decoding="async"
    />
    <div class="founder-band__inner">
      <span class="portrait-frame">
        <img src={founder.portrait} width="480" height="480" alt="" loading="eager" decoding="async" />
      </span>
      <div class="founder-copy">
        <p class="craft-chip">{t(`categories.${founder.craft}`)}</p>
        <h1 class="signature">{founderName}</h1>
        <p class="founder-meta">{founder.title[locale]}・{founder.region[locale]}</p>
        <div class="founder-bio">
          {bioParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        {
          snsLinks.length > 0 && (
            <ul class="founder-sns">
              {snsLinks.map(({ key, href }) => (
                <li>
                  <a href={href} rel="noopener noreferrer" target="_blank">
                    {key}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>
  </section>

  {
    founderProducts.length > 0 && (
      <section class="founder-products">
        <h2 class="section-heading">{productsHeading}</h2>
        <div class="product-grid">
          {founderProducts.map((product) => (
            <ProductCard product={product} founderName={founderName} locale={locale} />
          ))}
        </div>
      </section>
    )
  }

  <p class="back-link">
    <a href={localePath(locale, '/founders/')}>{t('founders.back')}</a>
  </p>
</Base>

<style>
  /* Full-width band (comp「PRODUIT—DÉTAIL」sibling section for founders):
     washi ground spanning the viewport, with the founder's own duotone
     portrait as a soft, low-opacity backdrop strip on the right — the
     full-color portrait stays the real focal point, framed left. */
  .founder-band {
    position: relative;
    width: 100%;
    background: var(--color-washi);
    overflow: hidden;
    isolation: isolate;
  }

  .founder-band__backdrop {
    position: absolute;
    inset: 0 0 0 auto;
    width: min(48%, 34rem);
    height: 100%;
    object-fit: cover;
    opacity: 0.16;
    mask-image: linear-gradient(to right, transparent, black 35%);
    -webkit-mask-image: linear-gradient(to right, transparent, black 35%);
    pointer-events: none;
    z-index: var(--z-base);
  }

  .founder-band__inner {
    position: relative;
    z-index: var(--z-raised);
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--space-9) var(--space-5);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .founder-band__inner {
      grid-template-columns: minmax(200px, 320px) minmax(0, 1fr);
      align-items: start;
    }
  }

  .craft-chip {
    display: inline-flex;
    align-self: flex-start;
    border-radius: var(--radius);
    border: 1px solid var(--color-ai);
    color: var(--color-ai);
    background: var(--color-kinari);
    padding: var(--space-1) var(--space-3);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .portrait-frame {
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: var(--radius);
    /* 版ズレ frame accent — a static two-tone ai/shu edge referencing print
       misregistration, rather than the dynamic hover-shift duplicate
       reserved for FounderCard/§3 — this hero is a signature context, not
       a hover surface. */
    border: 1px solid var(--color-ai);
    box-shadow:
      2px 2px 0 var(--color-shu),
      var(--shadow-paper);
  }

  .portrait-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .founder-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  /* 署名見出し (signature heading) — the one non-hover context DESIGN.md §3
     permits for the misregistration motif: a static ai/shu text-shadow
     offset on the founder's own name. */
  .signature {
    font-size: var(--text-2xl);
    text-shadow:
      1px 0 0 var(--color-ai),
      -1px 0 0 var(--color-shu);
  }

  .founder-meta {
    color: var(--color-sumi-usu);
    font-size: var(--text-base);
  }

  .founder-bio {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 60ch;
  }

  .founder-sns {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    list-style: none;
    padding: 0;
  }

  .founder-sns a {
    color: var(--color-ai);
    text-decoration: none;
    text-transform: capitalize;
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-ui) var(--ease-mie);
  }

  .founder-sns a:hover {
    border-color: var(--color-ai);
  }

  .founder-sns a:focus-visible {
    outline: 2px solid var(--color-shu);
    outline-offset: 2px;
  }

  .founder-sns a:active {
    color: var(--color-shu);
  }

  .founder-products {
    max-width: var(--container-max);
    margin-inline: auto;
    padding: 0 var(--space-5) var(--space-9);
  }

  /* Replaces the former `.kicker` reuse on this h2 — a section heading
     needs the display serif at real heading weight/size, not the muted
     small-caps 詞書 label style (which is right for an eyebrow, wrong for
     the products-by-this-founder heading itself). */
  .section-heading {
    margin-bottom: var(--space-5);
    font-size: var(--text-xl);
    color: var(--color-sumi);
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-6);
  }

  .back-link {
    max-width: var(--container-max);
    margin-inline: auto;
    padding: 0 var(--space-5) var(--space-11);
  }

  .back-link a {
    color: var(--color-ai);
    text-decoration: none;
  }

  .back-link a:hover {
    color: var(--color-shu);
    text-decoration: underline;
  }

  .back-link a:focus-visible {
    outline: 2px solid var(--color-shu);
    outline-offset: 2px;
  }
</style>
